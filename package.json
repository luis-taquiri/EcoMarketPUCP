{
  "name": "ecomarket-pucp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3200",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/init-db.ts && prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin": "tsx scripts/admin.ts",
    "test": "node scripts/test.mjs",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "lucide-react": "^0.545.0",
    "next": "15.5.28",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "deepmerge-ts": "^8.0.2"
  }
}
